# Configuration Backend - Contrôle Parental

# Base de données MongoDB
MONGO_URL=mongodb://localhost:27017
# En production avec Docker : mongodb://user:password@mongodb:27017

# Sécurité JWT
SECRET_KEY=change-this-to-a-random-secure-key-in-production
# Générer avec : openssl rand -hex 32

# CORS - Origins autorisées (séparés par des virgules)
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://192.168.100.94

# Exemple pour réseau local :
# ALLOWED_ORIGINS=http://localhost,http://192.168.1.*,http://192.168.220.*
